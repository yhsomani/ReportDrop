# ReportDrop Environment Variables
# Copy to .env and fill in real values for local development.
# Never commit real secrets.

# ─── Razorpay (REQUIRED for the payments flow) ─────────────────────────────────
# There is NO mock. The server calls the real Razorpay Orders API and fails
# closed (PAYMENT_CONFIG_ERROR) when these keys are absent — the feature is not
# pretend-working without them.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=rzp_test_xxxxxxxxxxxxxxxxxxxx

# ─── Cloudflare Workers ────────────────────────────────────────────────────────
# D1 binding is configured in wrangler.jsonc — no env var needed for local dev.
# For production, set the secret via `wrangler secret put RAZORPAY_KEY_SECRET`.
# Label for structured request logging (e.g. production / staging / test).
ENVIRONMENT=development

# Comma-separated allowlist of additional origins permitted to make credentialed
# CORS requests. The app's own origin and the Vite dev server are always allowed.
# Example: CORS_ORIGINS=https://app.reportdrop.example,https://reports.reportdrop.example
# CORS_ORIGINS=

# ─── Vite (client) ─────────────────────────────────────────────────────────────
# Absolute base URL for the API server when it is served from a different origin
# than the app (e.g. a Cloudflare Worker). Blank = same-origin (relative paths):
# in dev the Vite dev server answers /api/* through the real router (vite-api-dev.ts);
# in production the Worker answers /api/*. This is honored by the client request layer.
# VITE_API_URL=https://api.reportdrop.example
